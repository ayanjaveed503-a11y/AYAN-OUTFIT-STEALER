-- FIXED: Target character search mechanism simplified for absolute player execution
local function getCharacterByName(nameQuery)
local cleanName = string.match(nameQuery, "^%s*(.-)%s*$"):lower()
if cleanName == "" then return nil end
for _, plr in ipairs(Players:GetPlayers()) do
if string.sub(plr.Name:lower(), 1, #cleanName) == cleanName or string.sub(plr.DisplayName:lower(), 1, #cleanName) == cleanName then
return plr.Character
end
end
return nil
end
local function isCelestialSyndicate(character, searchName)
local tag = "Super"
if searchName and string.find(searchName:lower(), tag) then return true end
if not character then return false end
local plr = Players:GetPlayerFromCharacter(character)
if plr and (string.find(plr.Name:lower(), tag) or string.find(plr.DisplayName:lower(), tag)) then return true end
for _, attr in pairs(character:GetAttributes()) do
if type(attr) == "string" and string.find(attr:lower(), tag) then return true end
end
for _, desc in ipairs(character:GetDescendants()) do
if desc:IsA("StringValue") and string.find(desc.Value:lower(), tag) then
return true
elseif desc:IsA("TextLabel") or desc:IsA("TextButton") or desc:IsA("TextBox") then
local text = desc.Text:lower()
if string.find(text, tag) or string.find(text:gsub("<[^>]+>", ""), tag) then return true end
end
end
return false
end


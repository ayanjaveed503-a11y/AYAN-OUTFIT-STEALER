-- Live Humanoid Character Deep Model Scanner Action Trigger
ScanBtn.MouseButton1Click:Connect(function()
local nameText = NameInput.Text
if nameText == "" then return end
local character = LocalPlayer.Character or player.Character
local humanoid = character and character:FindFirstChildOfClass("Humanoid")
if not humanoid then return end
local desc = humanoid:GetAppliedDescription()
if not desc then return end
ScanBtn.Text = "SCANNING LIVE CHARACTER MODEL..."
ScanBtn.BackgroundColor3 = Color3.fromRGB(230, 126, 34)
local scannedItemsList = {}
-- 1. Extract Shirt & Pants
if desc.Shirt ~= 0 then table.insert(scannedItemsList, { id = desc.Shirt, category = "Shirt" }) end
if desc.Pants ~= 0 then table.insert(scannedItemsList, { id = desc.Pants, category = "Pants" }) end
if desc.GraphicTShirt ~= 0 then table.insert(scannedItemsList, { id = desc.GraphicTShirt, category = "T-Shirt" }) end
if desc.Face ~= 0 then table.insert(scannedItemsList, { id = desc.Face, category = "Face" }) end
-- 2. Extract Active Walk/Run Movements Animations Tokens
if desc.WalkAnimation ~= 0 then table.insert(scannedItemsList, { id = desc.WalkAnimation, category = "WalkAnimation" }) end
if desc.RunAnimation ~= 0 then table.insert(scannedItemsList, { id = desc.RunAnimation, category = "RunAnimation" }) end
if desc.IdleAnimation ~= 0 then table.insert(scannedItemsList, { id = desc.IdleAnimation, category = "IdleAnimation" }) end
if desc.JumpAnimation ~= 0 then table.insert(scannedItemsList, { id = desc.JumpAnimation, category = "JumpAnimation" }) end
-- 3. Extract Deep Hidden Stacked Attached Accessories (Hats, Hairs, Bags, Masks)
local success, accList = pcall(function() return desc:GetAccessories(true) end)
if success and type(accList) == "table" then
for _, acc in ipairs(accList) do
if acc.AssetId and acc.AssetId ~= 0 then
table.insert(scannedItemsList, {
id = acc.AssetId,
category = tostring(acc.AccessoryType and acc.AccessoryType.Name or "Accessory")
})
end
end
end

-- Local JSON Save Infrastructure
local StorageData = { outfits = {} }
local currentActiveOutfitIdx = nil

local function loadStorage()
    if readfile and isfile and isfile(FILE_NAME) then
        pcall(function()
            StorageData = HttpService:JSONDecode(readfile(FILE_NAME))
        end)
    end
end

local function saveStorage()
    if writefile then
        writefile(FILE_NAME, HttpService:JSONEncode(StorageData))
    end
end

local function getNetModule()
    local success, net = pcall(function() return require(ReplicatedStorage.Modules.Core.Net) end)
    return success and net or nil
end

-- Line-by-Line Asset Wear Router (Fixed Delay System)
local function applyGameOutfitStructure(itemsArray)
    local Net = getNetModule()
    if not Net then return end

    -- Reset Avatar to Blank State First
    pcall(function()
        Net.send("ClearOutfit")
        Net.send("wear_outfit_from_desc", { ["accessories"] = {}, ["properties"] = { ["Shirt"] = 0, ["Pants"] = 0 } })
    end)
    task.wait(0.5)

    if type(itemsArray) == "table" then
        for _, item in ipairs(itemsArray) do
            local assetId = tonumber(item.id)
            local category = tostring(item.category)

            if assetId and assetId ~= 0 then
                pcall(function()
                    if category == "Shirt" or category == "T-Shirt" then
                        Net.send("UpdateOutfit", "Shirt", assetId)
                        Net.get("code", assetId, "Shirt")
                    elseif category == "Pants" or category == "Shorts" then
                        Net.send("UpdateOutfit", "Pants", assetId)
                        Net.get("code", assetId, "Pants")
                    elseif category:find("Animation") then
                        Net.send("UpdateOutfit", category, assetId)
                        Net.get("code", assetId, category)
                    elseif category == "Face" then
                        Net.send("UpdateOutfit", "Face", assetId)
                        Net.get("code", assetId, "Face")
                    else
                        Net.send("UpdateOutfit", "Accessory", assetId)
                        Net.get("code", assetId, "Accessory")
                    end
                end)
                task.wait(0.25) -- Continuous delivery throttle buffer sync delay
            end
        end
        pcall(function() Net.send("RefreshCharacter") end)
    end
end


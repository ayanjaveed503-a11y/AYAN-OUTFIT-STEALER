-- File Storage Infrastructure
local SavedData = { outfits = {} }

local function loadStorage()
    if readfile and isfile and isfile(FILE_NAME) then
        pcall(function()
            SavedData = HttpService:JSONDecode(readfile(FILE_NAME))
        end)
    end
end

local function saveStorage()
    if writefile then
        writefile(FILE_NAME, HttpService:JSONEncode(SavedData))
    end
end

-- Network Handling Module for Core Logic
local function getNetModule()
    local success, net = pcall(function() 
        return require(ReplicatedStorage.Modules.Core.Net) 
    end)
    return success and net or nil
end

-- Outfit Processing Engine (Delete and Wear Execution)
local function applyOutfitCode(outfitCodeString)
    local Net = getNetModule()
    if not Net then return end

    -- Step 1: Complete Wipe/Delete System
    pcall(function()
        Net.send("wear_outfit_from_desc", {
            ["accessories"] = {},
            ["properties"] = {
                ["Shirt"] = 0, ["Pants"] = 0, ["GraphicTShirt"] = 0, ["Face"] = 0,
                ["Head"] = 0, ["Torso"] = 0, ["LeftArm"] = 0, ["RightArm"] = 0,
                ["LeftLeg"] = 0, ["RightLeg"] = 0, ["WalkAnimation"] = 0, ["RunAnimation"] = 0,
                ["JumpAnimation"] = 0, ["FallAnimation"] = 0, ["ClimbAnimation"] = 0,
                ["IdleAnimation"] = 0, ["SwimAnimation"] = 0, ["HeightScale"] = 1,
                ["HeadScale"] = 1, ["WidthScale"] = 1, ["DepthScale"] = 1,
                ["ProportionScale"] = 0, ["BodyTypeScale"] = 0
            }
        })
    end)
    
    task.wait(0.3) -- Essential buffer timing for clean server wipe

    -- Step 2: Extract Life Together code format tokens
    local shirtId, pantsId = string.match(outfitCodeString, "([^,]+),([^,]+)")
    if not shirtId or not pantsId then
        shirtId = outfitCodeString:match("^%d+$")
        pantsId = 0
    end

    -- Step 3: Server Remote Invocation to apply codes
    if shirtId and tonumber(shirtId) ~= 0 then
        pcall(function() Net.get("code", tonumber(shirtId), "Shirt") end)
        task.wait(0.2)
    end
    if pantsId and tonumber(pantsId) ~= 0 then
        pcall(function() Net.get("code", tonumber(pantsId), "Pants") end)
    end
end

-- UI Dynamic Compilation & Layout Rendering
local renderManagerPanel
renderManagerPanel = function()
    for _, child in pairs(ScrollFrame:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end

    for idx, data in ipairs(SavedData.outfits) do
        local cardFrame = Instance.new("Frame")
        cardFrame.Size = UDim2.new(1, -4, 0, 45)
        cardFrame.BackgroundColor3 = Color3.fromRGB(28, 35, 48)
        cardFrame.Parent = ScrollFrame

        local cardCorner = Instance.new("UICorner")
        cardCorner.CornerRadius = UDim.new(0, 6)
        cardCorner.Parent = cardFrame

        local nameLabel = Instance.new("TextLabel")
        nameLabel.Size = UDim2.new(0.5, 0, 1, 0)
        nameLabel.Position = UDim2.new(0, 10, 0, 0)
        nameLabel.BackgroundTransparency = 1
        nameLabel.Text = data.name or "Unnamed Outfit"
        nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        nameLabel.Font = Enum.Font.GothamMedium
        nameLabel.TextSize = 11
        nameLabel.TextXAlignment = Enum.TextXAlignment.Left
        nameLabel.Parent = cardFrame

        -- WEAR Operation Event
        local wearBtn = Instance.new("TextButton")
        wearBtn.Size = UDim2.new(0, 50, 0, 26)
        wearBtn.Position = UDim2.new(1, -115, 0, 9)
        wearBtn.BackgroundColor3 = Color3.fromRGB(0, 136, 255)
        wearBtn.Text = "WEAR"
        wearBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        wearBtn.Font = Enum.Font.GothamBold
        wearBtn.TextSize = 10
        wearBtn.Parent = cardFrame

        local wearCorner = Instance.new("UICorner")
        wearCorner.CornerRadius = UDim.new(0, 4)
        wearCorner.Parent = wearBtn

        wearBtn.MouseButton1Click:Connect(function()
            wearBtn.Text = "LOADING"
            wearBtn.BackgroundColor3 = Color3.fromRGB(100, 110, 120)
            applyOutfitCode(data.code)
            task.wait(0.5)
            wearBtn.Text = "WEAR"
            wearBtn.BackgroundColor3 = Color3.fromRGB(0, 136, 255)
        end)

        -- DELETE Operation Event
        local delBtn = Instance.new("TextButton")
        delBtn.Size = UDim2.new(0, 50, 0, 26)
        delBtn.Position = UDim2.new(1, -60, 0, 9)
        delBtn.BackgroundColor3 = Color3.fromRGB(231, 76, 60)
        delBtn.Text = "DELETE"
        delBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        delBtn.Font = Enum.Font.GothamBold
        delBtn.TextSize = 10
        delBtn.Parent = cardFrame

        local delCorner = Instance.new("UICorner")
        delCorner.CornerRadius = UDim.new(0, 4)
        delCorner.Parent = delBtn

        delBtn.MouseButton1Click:Connect(function()
            table.remove(SavedData.outfits, idx)
            saveStorage()
            renderManagerPanel()
        end)
    end
end


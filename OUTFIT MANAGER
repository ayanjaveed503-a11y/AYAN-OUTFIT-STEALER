-- Mock frameworks / Wrapper connections safely extracted
local Send = function(remote, ...) 
    local network = ReplicatedStorage:FindFirstChild("Network") or ReplicatedStorage:FindFirstChild("Net")
    if network then
        local remoteEvent = network:FindFirstChild(remote)
        if remoteEvent and remoteEvent:IsA("RemoteEvent") then
            remoteEvent:FireServer(...)
        end
    end
end

local Get = function(remote, ...)
    local network = ReplicatedStorage:FindFirstChild("Network") or ReplicatedStorage:FindFirstChild("Net")
    if network then
        local remoteFunction = network:FindFirstChild(remote)
        if remoteFunction and remoteFunction:IsA("RemoteFunction") then
            return remoteFunction:InvokeServer(...)
        end
    end
end

local function notify(title, text, duration)
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = title,
        Text = text,
        Duration = duration or 5
    })
end


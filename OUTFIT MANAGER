-- Storage Engine
local StorageData = { outfits = {} }

local function loadStorage()
    if readfile and isfile and isfile(FILE_NAME) then
        pcall(function()
            StorageData = HttpService:JSONDecode(readfile(FILE_NAME))
        end)
    end
end

local function saveStorage()
    if writefile then
        writefile(FILE_NAME, HttpService:JSONEncode(StorageData))
    end
end

local function getNetModule()
    local success, net = pcall(function() 
        return require(ReplicatedStorage.Modules.Core.Net) 
    end)
    return success and net or nil
end

-- Network Code Fetcher & Interpreter Engine
local function fetchAndAnalyzeGameCode(gameCode)
    local Net = getNetModule()
    if not Net then return nil end

    local outfitData = nil
    -- Game ke specific remote ko invoke karke pure alphanumeric code ka asset array dhoondna
    pcall(function()
        outfitData = Net.get("GetOutfit", gameCode) or Net.get("outfits", "get", gameCode)
    end)

    -- Game server internal format verification fallback
    if not outfitData then
        pcall(function()
            outfitData = ReplicatedStorage.Remotes.GetOutfit:InvokeServer(gameCode)
        end)
    end

    return outfitData
end

-- Deep Clean Wipe & Wear Execution
local function applyGameOutfitStructure(outfitStructure)
    local Net = getNetModule()
    if not Net then return end

    -- Step 1: Force Full Empty Character State Wipe
    pcall(function()
        Net.send("wear_outfit_from_desc", {
            ["accessories"] = {},
            ["properties"] = {
                ["Shirt"] = 0, ["Pants"] = 0, ["GraphicTShirt"] = 0, ["Face"] = 0,
                ["Head"] = 0, ["Torso"] = 0, ["LeftArm"] = 0, ["RightArm"] = 0,
                ["LeftLeg"] = 0, ["RightLeg"] = 0, ["WalkAnimation"] = 0, ["RunAnimation"] = 0,
                ["JumpAnimation"] = 0, ["FallAnimation"] = 0, ["ClimbAnimation"] = 0,
                ["IdleAnimation"] = 0, ["SwimAnimation"] = 0, ["HeightScale"] = 1,
                ["HeadScale"] = 1, ["WidthScale"] = 1, ["DepthScale"] = 1,
                ["ProportionScale"] = 0, ["BodyTypeScale"] = 0
            }
        })
    end)
    
    task.wait(0.4) -- Sync latency timing buffer

    -- Step 2: Game data tables parse karke asset execution loop chalana
    if type(outfitStructure) == "table" then
        -- Shirt & Pants Processing
        if outfitStructure.Shirt and tonumber(outfitStructure.Shirt) ~= 0 then
            pcall(function() Net.get("code", tonumber(outfitStructure.Shirt), "Shirt") end)
            task.wait(0.2)
        end
        if outfitStructure.Pants and tonumber(outfitStructure.Pants) ~= 0 then
            pcall(function() Net.get("code", tonumber(outfitStructure.Pants), "Pants") end)
            task.wait(0.2)
        end

        -- Accessories table processing loop
        if outfitStructure.accessories and type(outfitStructure.accessories) == "table" then
            for _, accId in ipairs(outfitStructure.accessories) do
                pcall(function() Net.get("code", tonumber(accId), "Accessory") end)
                task.wait(0.25)
            end
        elseif type(outfitStructure.Items) == "table" then -- Backup game structural key mapping
            for _, accId in ipairs(outfitStructure.Items) do
                pcall(function() Net.get("code", tonumber(accId), "Accessory") end)
                task.wait(0.25)
            end
        end
    end
end


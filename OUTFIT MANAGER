-- Storage Architecture
local StorageData = { outfits = {} }

local function loadStorage()
    if readfile and isfile and isfile(FILE_NAME) then
        pcall(function()
            StorageData = HttpService:JSONDecode(readfile(FILE_NAME))
        end)
    end
end

local function saveStorage()
    if writefile then
        writefile(FILE_NAME, HttpService:JSONEncode(StorageData))
    end
end

local function getNetModule()
    local success, net = pcall(function() 
        return require(ReplicatedStorage.Modules.Core.Net) 
    end)
    return success and net or nil
end

-- String Processing / Int Regex Extraction Engine
local function analyzeCodeString(rawString)
    local extractedIds = {}
    -- Pure numeric continuous segments ko scan karne ka mathematical loop
    for id in string.gmatch(rawString, "%d+") do
        local numericVal = tonumber(id)
        if numericVal and numericVal > 100000 then -- Filters out low default parameters/flags
            table.insert(extractedIds, numericVal)
        end
    end
    return extractedIds
end

-- Deep Execution Routine: Wipe followed by Array Asset Deployment
local function applyAnalyzedAssetArray(idArray)
    local Net = getNetModule()
    if not Net then return end

    -- Step 1: Force Global State Wipe
    pcall(function()
        Net.send("wear_outfit_from_desc", {
            ["accessories"] = {},
            ["properties"] = {
                ["Shirt"] = 0, ["Pants"] = 0, ["GraphicTShirt"] = 0, ["Face"] = 0,
                ["Head"] = 0, ["Torso"] = 0, ["LeftArm"] = 0, ["RightArm"] = 0,
                ["LeftLeg"] = 0, ["RightLeg"] = 0, ["WalkAnimation"] = 0, ["RunAnimation"] = 0,
                ["JumpAnimation"] = 0, ["FallAnimation"] = 0, ["ClimbAnimation"] = 0,
                ["IdleAnimation"] = 0, ["SwimAnimation"] = 0, ["HeightScale"] = 1,
                ["HeadScale"] = 1, ["WidthScale"] = 1, ["DepthScale"] = 1,
                ["ProportionScale"] = 0, ["BodyTypeScale"] = 0
            }
        })
    end)
    
    task.wait(0.4) -- Buffer constraint to sync network clean-up state

    -- Step 2: Adaptive Context Engine for Life Together Remote Targets
    -- Array ki unique ordering ko read karke process apply karna
    for index, assetId in ipairs(idArray) do
        pcall(function()
            if index == 1 then
                Net.get("code", assetId, "Shirt")
            elseif index == 2 then
                Net.get("code", assetId, "Pants")
            else
                -- Fallback sequence explicitly routes remaining values to Accessories
                Net.get("code", assetId, "Accessory")
            end
        end)
        task.wait(0.25) -- Safe firing cooldown parameters to avoid remote exhaustion throttling
    end
end


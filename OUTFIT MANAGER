    local bp = Instance.new("UIPadding", box) bp.PaddingLeft = UDim.new(0, 6)

    activeInputs[storageKey] = box
end

-- Tab Windows Mapping Framework
local TabFrames = {}
local function buildTabFrames()
    local categories = {
        {"Clothing", {"ShirtID", "PantsID", "GraphicTShirtID"}},
        {"Head & Face", {"HairID", "HatID", "GlassesID", "FaceMaskID"}},
        {"Accessories", {"NeckID", "ShoulderID", "BackPackID", "WaistID"}},
        {"Style", {"FaceExpressionID", "WalkAnimID", "RunAnimID", "IdleAnimID"}}
    }

    for _, catData in ipairs(categories) do
        local catName = catData[1]
        local keys = catData[2]

        local tFrame = Instance.new("Frame")
        tFrame.Size = UDim2.new(1, 0, 1, 0)
        tFrame.BackgroundTransparency = 1
        tFrame.Visible = false
        tFrame.Parent = ContentArea
        TabFrames[catName] = tFrame

        local y = 8
        for _, key in ipairs(keys) do
            createTabField(tFrame, y, key:gsub("ID", ""), key)
            y = y + 42
        end

        -- Tab Toggle Buttons Build
        local tBtn = Instance.new("TextButton")
        tBtn.Size = UDim2.new(1, 0, 0, 34)
        tBtn.BackgroundColor3 = Color3.fromRGB(28, 34, 46)
        tBtn.Text = "  " .. catName:upper()
        tBtn.TextColor3 = Color3.fromRGB(200, 210, 230)
        tBtn.Font = Enum.Font.GothamBold
        tBtn.TextSize = 10
        tBtn.TextXAlignment = Enum.TextXAlignment.Left
        tBtn.Parent = TabBar
        Instance.new("UICorner", tBtn).CornerRadius = UDim.new(0, 6)

        tBtn.MouseButton1Click:Connect(function()
            for _, f in pairs(TabFrames) do f.Visible = false end
            for _, b in ipairs(TabBar:GetChildren()) do 
                if b:IsA("TextButton") then b.BackgroundColor3 = Color3.fromRGB(28, 34, 46) end 
            end
            tFrame.Visible = true
            tBtn.BackgroundColor3 = Color3.fromRGB(0, 136, 255)
        end)
    end
    -- Default selection state
    if TabFrames["Clothing"] then TabFrames["Clothing"].Visible = true end
    local initialBtn = TabBar:FindFirstChildOfClass("TextButton")
    if initialBtn then initialBtn.BackgroundColor3 = Color3.fromRGB(0, 136, 255) end
end

-- Life Together Core Execution Framework Remotes Mapping (Stable Line-by-Line Engine)
local function applyComponentOutfit(dataBlock)
    local Net = getNetModule()
    if not Net then return end

    -- Step 1: Wipe Character Avatar Layout Clean
    pcall(function()
        Net.send("ClearOutfit")
        Net.send("wear_outfit_from_desc", { ["accessories"] = {}, ["properties"] = { ["Shirt"] = 0, ["Pants"] = 0 } })
    end)
    task.wait(0.5)

-- Step 2: Line-by-Line Order Injection System
local function deploy(id, itemType)
if id and tonumber(id) and tonumber(id) ~= 0 then
pcall(function() Net.send("UpdateOutfit", itemType, tonumber(id)) end)
pcall(function() Net.get("code", tonumber(id), itemType) end)
task.wait(0.25)
end
end
